# BasicRfiFlow

main: kit: flow: BasicRfiFlow:
{
  entity: "rfi",
  kind: "basic",
  name: "BasicRfiFlow",
  step: [
    {
      i: {
        ref: "rfi_ref01"
      }

      m: {
        account_id: "account01",
        project_type: "project_type01"
      }

      o: "create"
    }

    {
      d: {
        account_id: "account01",
        project_type: "project_type01"
      }

      i: {
        ref: "rfi_ref01",
        srcdatavar: "rfi_ref01_data",
        suffix: "_up0",
        textfield: "assignee"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-rfi_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "rfi_ref01",
        srcdatavar: "rfi_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "rfi01",
        project_type: "project_type01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-rfi_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRfiFlow"
}