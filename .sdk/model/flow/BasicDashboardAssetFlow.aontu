# BasicDashboardAssetFlow

main: kit: flow: BasicDashboardAssetFlow:
{
  entity: "dashboard_asset",
  kind: "basic",
  name: "BasicDashboardAssetFlow",
  step: [
    {
      i: {
        ref: "dashboard_asset_ref01"
      }

      m: {
        account_id: "account01",
        project_type: "project_type01",
        request_id: "request01"
      }

      o: "create"
    }

    {
      i: {
        ref: "dashboard_asset_ref01",
        srcdatavar: "dashboard_asset_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "dashboard_asset01",
        project_type: "project_type01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-dashboard_asset_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDashboardAssetFlow"
}