# BasicGroupFlow

main: kit: flow: BasicGroupFlow:
{
  entity: "group",
  kind: "basic",
  name: "BasicGroupFlow",
  step: [
    {
      i: {
        ref: "group_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "group_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "group_ref01",
        srcdatavar: "group_ref01_data",
        suffix: "_up0",
        textfield: "createdAt"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-group_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "group_ref01",
        srcdatavar: "group_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "group01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-group_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "group_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "group01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "group_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicGroupFlow"
}