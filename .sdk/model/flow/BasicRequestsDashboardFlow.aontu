# BasicRequestsDashboardFlow

main: kit: flow: BasicRequestsDashboardFlow:
{
  entity: "requests_dashboard",
  kind: "basic",
  name: "BasicRequestsDashboardFlow",
  step: [
    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "requests_dashboard_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "requests_dashboard_ref01",
        srcdatavar: "requests_dashboard_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "requests_dashboard01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-requests_dashboard_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRequestsDashboardFlow"
}