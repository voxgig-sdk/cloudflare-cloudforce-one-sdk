# BasicPriorityFlow

main: kit: flow: BasicPriorityFlow:
{
  entity: "priority",
  kind: "basic",
  name: "BasicPriorityFlow",
  step: [
    {
      i: {
        ref: "priority_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "priority_ref01",
        srcdatavar: "priority_ref01_data",
        suffix: "_up0",
        textfield: "requirement"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-priority_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "priority_ref01",
        srcdatavar: "priority_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "priority01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-priority_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPriorityFlow"
}