# BasicBrandProtectionFlow

main: kit: flow: BasicBrandProtectionFlow:
{
  entity: "brand_protection",
  kind: "basic",
  name: "BasicBrandProtectionFlow",
  step: [
    {
      i: {
        ref: "brand_protection_ref01"
      }

      m: {
        account_id: "account01",
        takedown_notice_id: "takedown_notice01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "brand_protection_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "brand_protection_ref01",
        srcdatavar: "brand_protection_ref01_data",
        suffix: "_up0",
        textfield: "action"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-brand_protection_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "brand_protection_ref01",
        srcdatavar: "brand_protection_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "brand_protection01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-brand_protection_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "brand_protection_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "brand_protection01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "brand_protection_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBrandProtectionFlow"
