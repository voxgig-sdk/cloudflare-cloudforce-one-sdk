# BasicPublicCredentialMonitorFlow

main: kit: flow: BasicPublicCredentialMonitorFlow:
{
  entity: "public_credential_monitor",
  kind: "basic",
  name: "BasicPublicCredentialMonitorFlow",
  step: [
    {
      i: {
        ref: "public_credential_monitor_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "public_credential_monitor_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "public_credential_monitor_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "public_credential_monitor01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "public_credential_monitor_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPublicCredentialMonitorFlow"
}