# BasicIndicatorFlow

main: kit: flow: BasicIndicatorFlow:
{
  entity: "indicator",
  kind: "basic",
  name: "BasicIndicatorFlow",
  step: [
    {
      i: {
        ref: "indicator_ref01"
      }

      m: {
        account_id: "account01",
        dataset_id: "dataset01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01",
        dataset_id: "dataset01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "indicator_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01",
        dataset_id: "dataset01"
      }

      i: {
        ref: "indicator_ref01",
        srcdatavar: "indicator_ref01_data",
        suffix: "_up0",
        textfield: "createdAt"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-indicator_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "indicator_ref01",
        srcdatavar: "indicator_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        dataset_id: "dataset01",
        id: "indicator01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-indicator_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "indicator_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        dataset_id: "dataset01",
        id: "indicator01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01",
        dataset_id: "dataset01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "indicator_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicIndicatorFlow"
}