# BasicTagFlow

main: kit: flow: BasicTagFlow:
{
  entity: "tag",
  kind: "basic",
  name: "BasicTagFlow",
  step: [
    {
      i: {
        ref: "tag_ref01"
      }

      m: {
        account_id: "account01",
        dataset_id: "dataset01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "tag_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "tag_ref01",
        srcdatavar: "tag_ref01_data",
        suffix: "_up0",
        textfield: "activeDuration"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-tag_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "tag_ref01",
        srcdatavar: "tag_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "tag01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-tag_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "tag_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "tag01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "tag_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTagFlow"
}