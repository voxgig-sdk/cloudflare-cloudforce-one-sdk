# BasicBinDbFlow

main: kit: flow: BasicBinDbFlow:
{
  entity: "bin_db",
  kind: "basic",
  name: "BasicBinDbFlow",
  step: [
    {
      i: {
        ref: "bin_db_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      i: {
        ref: "bin_db_ref01",
        srcdatavar: "bin_db_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "bin_db01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-bin_db_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBinDbFlow"
}