# BasicCollectionFlow

main: kit: flow: BasicCollectionFlow:
{
  entity: "collection",
  kind: "basic",
  name: "BasicCollectionFlow",
  step: [
    {
      i: {
        ref: "collection_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "collection_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "collection_ref01",
        srcdatavar: "collection_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-collection_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "collection_ref01",
        srcdatavar: "collection_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "collection01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-collection_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "collection_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "collection01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "collection_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCollectionFlow"
}